# ---------------------------------------------------------------
# K8s 管理平台环境变量
# 复制为 .env 后按需修改
# ---------------------------------------------------------------

# --- kubeconfig ---
# 留空则按 KUBECONFIG > K8S_CONFIG_PATH > D:\config > uploaded-kubeconfig.yaml 顺序查找
# KUBECONFIG=D:\config
# K8S_CONFIG_PATH=D:\config

# 集群连不上时是否退回内置演示集群（1=允许，0=直接报错）
ALLOW_DEMO_FALLBACK=1

# --- 服务端口 ---
BACKEND_PORT=8000
AI_PORT=5001

# --- AI 助手使用的大模型（OpenAI 兼容接口）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=120

# --- 审计日志路径 ---
# AUDIT_LOG=./audit.log
