# kubeconfig 路径（默认 D:\config），也可以指向 ~/.kube/config
KUBECONFIG_PATH=D:\config
# 指定 context，留空使用当前 context
KUBE_CONTEXT=

# 读不到 kubeconfig / 连不上集群时，是否退化为内置演示数据（1=是）
ALLOW_MOCK_FALLBACK=1
# 强制使用演示数据（1=是，不尝试连接集群）
FORCE_MOCK=0

# 服务端口
BACKEND_PORT=5000
AI_PORT=5001
DEFAULT_NAMESPACE=default

# AI 助手访问后端的地址
BACKEND_URL=http://127.0.0.1:5000

# 大模型（OpenAI 兼容协议）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
MAX_TOOL_ROUNDS=6
